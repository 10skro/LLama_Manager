{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/local",
  "provider": {
    "llamacpp": {
      "api": "openai",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "local": {
          "name": "llama.cpp local",
          "limit": {
            "context": 80000,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "bash": {
      "git *": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git tag *": "ask"
    }
  }
}
